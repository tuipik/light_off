TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
ALERT_TELEGRAM_CHAT_ID=your_personal_chat_id
YOUR_QUEUE=GPV3.2
CHECK_INTERVAL_MINUTES=20
TIMEZONE=Europe/Kyiv
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=1
# PLAYWRIGHT_USER_AGENT=
AUTO_HEADFUL_ON_BLOCK=1
ENABLE_HTTP_PREFETCH=0
MAX_BACKOFF_MINUTES=60
MIN_BLOCK_BACKOFF_MINUTES=60
BLOCK_ALERT_COOLDOWN_MINUTES=360
PLAYWRIGHT_GOTO_TIMEOUT_MS=60000
HTTP_TIMEOUT_SECONDS=20
BLOCK_DEBUG_ENABLED=1
BLOCK_DEBUG_DIR=debug/blocks
BLOCK_DEBUG_MAX_ARTIFACTS=20
# DTEK_COOKIE=visid_incap_...; incap_ses_...=...
# Важливо: вставляйте значення Cookie header (name=value; ...), без "Domain=...", "Path=...".
# Для Incapsula зазвичай достатньо visid_incap_* та incap_ses_* (і за потреби nlbi_*).
